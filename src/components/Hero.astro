---
export interface HeroItem {
  slug: string;
  titleFa: string;
  titleEn: string;
  description: string;
  genres: string[];
  metaLine: string;
  rating: string;
  quality: string;
  dubbed: boolean;
  backdrop: string;
  detailHref: string;
  watchHref: string;
  type?: string;
}

interface Props {
  items: HeroItem[];
}

const { items } = Astro.props;
const first = items[0];
const eyebrowFor = (it: HeroItem) =>
  it.type === 'series' ? 'سریال پیشنهادی' : it.type === 'animation' ? 'انیمیشن پیشنهادی' : 'فیلم پیشنهادی';
/** Responsive variants of upera thumb URLs (w/h params), with fallback to plain src. */
const srcSetFor = (url: string): string | null => {
  if (!url || !url.includes('thumb.upera.tv/thumb?') || !url.includes('w=1120')) return null;
  const v = (w: number, h: number) => url.replace('w=1120', `w=${w}`).replace('h=576', `h=${h}`);
  return `${v(640, 329)} 640w, ${v(1120, 576)} 1120w, ${v(1920, 987)} 1920w`;
};
---
{first && (
  <section class="hero" data-hero aria-label="پیشنهاد ویژه">
    <div class="hero-media" aria-hidden="false">
      {items.map((it, i) => (
        <div class={`hero-slide${i === 0 ? ' is-active' : ''}`} data-slide={i} aria-hidden={i === 0 ? 'false' : 'true'}>
          <img
            src={it.backdrop}
            srcset={srcSetFor(it.backdrop) ?? undefined}
            sizes={srcSetFor(it.backdrop) ? '(max-width: 767px) 100vw, 1280px' : undefined}
            alt=""
            loading={i === 0 ? 'eager' : 'lazy'}
            decoding="async"
            fetchpriority={i === 0 ? 'high' : undefined}
            width="1280"
            height="720"
            class="hero-img"
          />
        </div>
      ))}
      <div class="hero-shade" aria-hidden="true"></div>
    </div>

    <div class="hero-content">
      {items.map((it, i) => (
        <div class={`hero-copy${i === 0 ? ' is-active' : ''}`} data-copy={i} aria-hidden={i === 0 ? 'false' : 'true'}>
          <p class="hero-eyebrow">{eyebrowFor(it)}</p>
          <h1 class="hero-title">{it.titleFa}</h1>
          <p class="hero-desc">{it.description}</p>
          <div class="hero-actions">
            <a href={it.watchHref} class="hero-cta">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <polygon points="6 3 20 12 6 21 6 3" />
              </svg>
              تماشای فیلم
            </a>
          </div>
          {items.length > 1 && (
            <div class="hero-dots" role="tablist" aria-label="انتخاب عنوان ویژه">
              {items.map((d, k) => (
                <button
                  type="button"
                  role="tab"
                  aria-selected={k === 0 ? 'true' : 'false'}
                  aria-label={`نمایش ${d.titleFa}`}
                  class={`hero-dot${k === 0 ? ' is-active' : ''}`}
                  data-dot={k}
                />
              ))}
            </div>
          )}
        </div>
      ))}
    </div>

    {items.length > 1 && (
      <>
        <button type="button" class="hero-arrow hero-arrow-next" data-next aria-label="عنوان بعدی">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 6 6 6-6 6" /></svg>
        </button>
        <button type="button" class="hero-arrow hero-arrow-prev" data-prev aria-label="عنوان قبلی">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 6-6 6 6 6" /></svg>
        </button>
      </>
    )}
  </section>
)}

<style>
  .hero {
    position: relative;
    overflow: hidden;
    border-radius: 1.8rem;
    border: 1px solid rgba(255, 255, 255, .09);
    background: #101018;
    height: clamp(400px, 52vh, 480px);
    box-shadow: 0 30px 90px rgba(0, 0, 0, .45), 0 0 70px rgba(130, 36, 86, .12);
    isolation: isolate;
  }
  .hero-media, .hero-slide { position: absolute; inset: 0; }
  .hero-slide { opacity: 0; transition: opacity .8s ease; }
  .hero-slide.is-active { opacity: 1; z-index: 1; }
  .hero-img { width: 100%; height: 100%; object-fit: cover; object-position: center 30%; filter: saturate(.9) contrast(1.05); }
  .hero-slide.is-active .hero-img { animation: kenburns 20s ease-in-out infinite alternate; }
  @keyframes kenburns {
    from { transform: scale(1) translate(0, 0); }
    to { transform: scale(1.1) translate(-2%, 1.5%); }
  }
  .hero-shade {
    position: absolute;
    inset: 0;
    z-index: 2;
    background:
      linear-gradient(to top, rgba(8, 8, 14, .55) 0%, transparent 40%),
      linear-gradient(to left, rgba(10, 8, 18, .96) 0%, rgba(10, 8, 18, .78) 34%, rgba(10, 8, 18, .25) 62%, transparent 85%);
  }
  .hero-content {
    position: absolute;
    z-index: 3;
    inset-block: 0;
    inset-inline-end: 0;
    width: min(500px, 48%);
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 2.5rem 3.25rem;
    color: #fff;
    text-align: start;
  }
  .hero-copy { display: none; flex-direction: column; align-items: flex-start; gap: .7rem; }
  .hero-copy.is-active { display: flex; animation: copy-in .55s ease both; }
  @keyframes copy-in {
    from { opacity: 0; transform: translateY(14px); }
    to { opacity: 1; transform: none; }
  }
  .hero-eyebrow {
    margin: 0;
    font-size: .8rem;
    font-weight: 700;
    color: #ff8ba0;
  }
  .hero-title {
    margin: 0;
    font-size: 2rem;
    font-weight: 900;
    line-height: 1.5;
    text-wrap: balance;
  }
  .hero-desc {
    margin: 0;
    font-size: .88rem;
    line-height: 2.1;
    color: rgba(235, 232, 240, .72);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    max-width: 44ch;
  }
  .hero-actions { display: flex; margin-top: .35rem; }
  .hero-cta {
    display: inline-flex;
    align-items: center;
    gap: .5rem;
    min-height: 2.9rem;
    padding-inline: 1.7rem;
    border-radius: 999px;
    font-size: .9rem;
    font-weight: 800;
    color: #fff;
    background: linear-gradient(135deg, #ff5a76, #d91d4b);
    box-shadow: 0 8px 28px rgba(255, 45, 96, .5), inset 0 1px 0 rgba(255, 255, 255, .3);
    transition: transform .2s ease, box-shadow .2s ease;
  }
  .hero-cta:hover { transform: translateY(-2px); box-shadow: 0 12px 34px rgba(255, 45, 96, .6); }
  .hero-dots { display: flex; align-items: center; gap: .45rem; margin-top: .8rem; }
  .hero-dot {
    width: .55rem;
    height: .55rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, .3);
    border: 0;
    padding: 0;
    cursor: pointer;
    transition: width .3s ease, background .3s ease;
  }
  .hero-dot.is-active { width: 1.7rem; background: var(--brand); box-shadow: 0 0 12px rgba(251, 69, 103, .7); }
  .hero-arrow {
    position: absolute;
    z-index: 4;
    top: 50%;
    translate: 0 -50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 999px;
    color: rgba(255, 255, 255, .85);
    background: rgba(255, 255, 255, .12);
    border: 1px solid rgba(255, 255, 255, .16);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    cursor: pointer;
    transition: background .2s ease, transform .2s ease;
  }
  .hero-arrow:hover { background: rgba(255, 255, 255, .22); transform: scale(1.05); }
  .hero-arrow-next { inset-inline-end: 1.1rem; }
  .hero-arrow-prev { inset-inline-start: 1.1rem; }
  @media (max-width: 767px) {
    .hero { height: 500px; border-radius: 1.25rem; }
    .hero-shade {
      background:
        linear-gradient(to top, rgba(8, 8, 14, .94) 0%, rgba(8, 8, 14, .55) 45%, transparent 80%),
        linear-gradient(to left, rgba(8, 8, 14, .35), transparent 70%);
    }
    .hero-content {
      inset-inline: 0;
      inset-block: auto 0;
      width: auto;
      padding: 1.25rem 1.4rem 1.6rem;
    }
    .hero-title { font-size: 1.35rem; }
    .hero-arrow { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-slide, .hero-copy.is-active, .hero-dot { animation: none; transition: none; }
    .hero-slide.is-active .hero-img { animation: none; }
  }
</style>

<script>
  const root = document.querySelector('[data-hero]') as HTMLElement | null;
  if (root) {
    const slides = Array.from(root.querySelectorAll<HTMLElement>('[data-slide]'));
    const copies = Array.from(root.querySelectorAll<HTMLElement>('[data-copy]'));
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-dot]'));
    const nextBtn = root.querySelector<HTMLButtonElement>('[data-next]');
    const prevBtn = root.querySelector<HTMLButtonElement>('[data-prev]');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const DURATION = 8000;
    let idx = 0;
    let timer: number | null = null;

    const show = (i: number) => {
      idx = (i + slides.length) % slides.length;
      slides.forEach((s, k) => {
        const on = k === idx;
        s.classList.toggle('is-active', on);
        s.setAttribute('aria-hidden', String(!on));
      });
      copies.forEach((c, k) => {
        const on = k === idx;
        c.classList.toggle('is-active', on);
        c.setAttribute('aria-hidden', String(!on));
      });
      dots.forEach((d, k) => {
        const on = k === idx;
        d.classList.toggle('is-active', on);
        d.setAttribute('aria-selected', String(on));
      });
    };

    const stop = () => {
      if (timer !== null) {
        window.clearInterval(timer);
        timer = null;
      }
    };
    const start = () => {
      if (reduceMotion || slides.length < 2) return;
      stop();
      timer = window.setInterval(() => show(idx + 1), DURATION);
    };

    dots.forEach((d, k) => {
      d.addEventListener('click', () => {
        show(k);
        start();
      });
    });
    nextBtn?.addEventListener('click', () => {
      show(idx + 1);
      start();
    });
    prevBtn?.addEventListener('click', () => {
      show(idx - 1);
      start();
    });
    root.addEventListener('mouseenter', stop);
    root.addEventListener('mouseleave', start);
    root.addEventListener('focusin', stop);
    root.addEventListener('focusout', start);
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) stop();
      else start();
    });

    show(idx);
    start();
  }
</script>
