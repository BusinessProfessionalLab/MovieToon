---
import { NAV } from '../lib/site';
---
<header class="site-header sticky top-0 z-40 border-b" style="border-color: var(--border)">
  <div class="mx-auto max-w-7xl px-4 flex items-center gap-3 h-16">
    <button
      id="menu-btn"
      class="md:hidden p-2 rounded-lg border"
      style="border-color: var(--border)"
      aria-label="باز کردن منو"
      aria-expanded="false"
    >
      ☰
    </button>
    <a href="/" class="flex items-center gap-2 font-black text-xl" aria-label="مووی‌تون - صفحه اصلی">
      <span class="inline-flex w-9 h-9 items-center justify-center rounded-xl text-white font-black" style="background: var(--brand)">م</span>
      <span>مووی‌تون</span>
    </a>
    <nav class="hidden md:flex items-center gap-5 text-sm font-medium" aria-label="ناوبری اصلی">
      {NAV.map((n) => <a class="hover:opacity-80" href={n.href}>{n.label}</a>)}
    </nav>
    <div class="ms-auto flex items-center gap-2">
      <a href="/search" class="p-2 rounded-lg border" style="border-color: var(--border)" aria-label="جستجو">🔍</a>
      <button id="theme-btn" class="p-2 rounded-lg border" style="border-color: var(--border)" aria-label="تغییر تم">🌙</button>
      <a data-guest href="/login" class="hidden sm:inline-flex btn-ghost text-sm">ورود</a>
      <a data-guest href="/register" class="hidden sm:inline-flex btn-primary text-sm">ثبت‌نام</a>
      <a data-member href="/profile" class="hidden sm:inline-flex btn-ghost text-sm">حساب من</a>
      <a data-member href="/profile" class="hidden p-2 rounded-lg border sm:hidden" style="border-color: var(--border)" aria-label="حساب کاربری">👤</a>
    </div>
  </div>
  <div id="mobile-drawer" class="md:hidden hidden border-t px-4 py-3" style="border-color: var(--border)">
    <nav class="flex flex-col gap-1" aria-label="منوی موبایل">
      {NAV.map((n) => <a class="py-2 border-b last:border-0" style="border-color: var(--border)" href={n.href}>{n.label}</a>)}
      <div class="flex gap-2 pt-3">
        <a data-guest href="/login" class="btn-ghost text-sm flex-1 text-center">ورود</a>
        <a data-guest href="/register" class="btn-primary text-sm flex-1 text-center">ثبت‌نام</a>
        <a data-member href="/profile" class="hidden btn-ghost text-sm flex-1 text-center">حساب من</a>
      </div>
    </nav>
  </div>
  <div class="md:hidden border-t" style="border-color: var(--border)">
    <nav class="mx-auto max-w-7xl px-2 flex gap-1 overflow-x-auto no-scrollbar text-xs py-2" aria-label="ناوبری موبایل">
      <a href="/" class="px-3 py-2 rounded-lg whitespace-nowrap">خانه</a>
      {NAV.slice(0, 5).map((n) => <a href={n.href} class="px-3 py-2 rounded-lg whitespace-nowrap">{n.label}</a>)}
    </nav>
  </div>
</header>
<script is:inline>
  const btn = document.getElementById('menu-btn');
  const drawer = document.getElementById('mobile-drawer');
  btn?.addEventListener('click', () => {
    const open = drawer?.classList.toggle('hidden');
    btn.setAttribute('aria-expanded', String(!open));
  });
  const themeBtn = document.getElementById('theme-btn');
  const syncIcon = () => {
    const t = document.documentElement.getAttribute('data-theme');
    if (themeBtn) themeBtn.textContent = t === 'dark' ? '🌙' : '☀️';
  };
  syncIcon();
  themeBtn?.addEventListener('click', () => {
    const cur = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
    document.documentElement.setAttribute('data-theme', cur);
    try { localStorage.setItem('movietoon-theme', cur); } catch {}
    syncIcon();
  });
</script>
<script is:inline>
  (async () => {
    const readUser = async () => {
      const pickUser = (body) => body?.data?.user ?? body?.data ?? null;
      const response = await fetch('/api/auth/me', { credentials: 'same-origin' });
      if (response.status !== 401) return response.ok ? pickUser(await response.json()) : null;
      const refreshed = await fetch('/api/auth/refresh', { method: 'POST', credentials: 'same-origin' });
      if (!refreshed.ok) return null;
      const current = await fetch('/api/auth/me', { credentials: 'same-origin' });
      return current.ok ? pickUser(await current.json()) : null;
    };
    try {
      const user = await readUser();
      document.querySelectorAll('[data-guest]').forEach((el) => el.classList.toggle('hidden', Boolean(user)));
      document.querySelectorAll('[data-member]').forEach((el) => el.classList.toggle('hidden', !user));
      document.querySelectorAll('[data-admin-only]').forEach((el) => el.classList.toggle('hidden', user?.role !== 'admin'));
    } catch {}
  })();
</script>
<style>
  .site-header { background: rgba(9, 10, 16, .78); backdrop-filter: blur(22px) saturate(150%); border-color: rgba(255,255,255,.08) !important; }
  .site-header > div:first-child { height: 4.5rem; }
  .site-header a[aria-label*="ØµÙØ­Ù‡"] > span:first-child { box-shadow: 0 0 26px rgba(251,69,103,.48); border-radius: 13px; }
  .site-header nav a { color: rgba(246,244,249,.78); transition: color .2s ease, opacity .2s ease; }
  .site-header nav a:hover { color: #fff; opacity: 1; }
  .site-header button, .site-header .ms-auto > a { border-color: rgba(255,255,255,.11) !important; background: rgba(255,255,255,.045); transition: background .2s ease, border-color .2s ease, transform .2s ease; }
  .site-header button:hover, .site-header .ms-auto > a:hover { background: rgba(255,255,255,.1); border-color: rgba(255,255,255,.24) !important; transform: translateY(-1px); }
  .site-header .ms-auto > a.btn-primary { background: linear-gradient(135deg,#ff5a76,#d91d4b); }
  .site-header #mobile-drawer { background: rgba(10,11,17,.96); }
  .site-header > div:last-child { border-color: rgba(255,255,255,.07) !important; background: rgba(255,255,255,.018); }
  @media (prefers-reduced-motion: reduce) { .site-header * { transition: none !important; } }
</style>
