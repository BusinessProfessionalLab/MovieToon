---
interface Props {
  title: string;
  moreHref?: string;
  moreText?: string;
}
const { title, moreHref, moreText = 'مشاهده همه ←' } = Astro.props;
---
<div class="flex items-center justify-between mb-4">
  <h2 class="font-black text-lg md:text-xl flex items-center gap-2">
    <span class="inline-block w-1.5 h-6 rounded-full" style="background: var(--brand)" aria-hidden="true"></span>
    {title}
  </h2>
  {moreHref && <a href={moreHref} class="text-sm font-bold" style="color: var(--brand)">{moreText}</a>}
</div>
