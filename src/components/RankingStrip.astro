---
import type { Title } from '../types';
import { toFa, toFaDecimal } from '../lib/fa';
import { routeFor } from '../lib/repository';

interface Props {
  items: Title[];
}

const { items } = Astro.props;
---
<ol class="rank-strip" aria-label="رتبه‌بندی ده عنوان برتر">
  {items.slice(0, 10).map((t, i) => {
    const rank = t.top10Rank ?? i + 1;
    return (
      <li class="rank-item">
        <a href={routeFor(t)} class="rank-link" aria-label={`رتبه ${toFa(rank)}: ${t.titleFa}`}>
          <span class="rank-num" aria-hidden="true">{toFa(rank)}</span>
          <span class="rank-poster">
            <img
              src={t.poster}
              alt=""
              aria-hidden="true"
              loading="lazy"
              decoding="async"
              width="120"
              height="180"
            />
            <span class="rank-play" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <polygon points="6 3 20 12 6 21 6 3" />
              </svg>
            </span>
          </span>
          <span class="rank-meta">
            <span class="rank-title">{t.titleFa}</span>
            <span class="rank-sub muted">
              <svg width="11" height="11" viewBox="0 0 24 24" fill="var(--gold)" aria-hidden="true">
                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
              </svg>
              {toFaDecimal(t.imdb)}
              <span aria-hidden="true"> • </span>
              {t.genres.slice(0, 2).join('، ')}
            </span>
          </span>
        </a>
      </li>
    );
  })}
</ol>

<style>
  .rank-strip {
    list-style: none;
    margin: 0;
    padding: 0.25rem 0.1rem 0.75rem;
    display: flex;
    gap: 1.1rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
  }
  .rank-item {
    scroll-snap-align: start;
    flex: 0 0 auto;
  }
  .rank-link {
    display: flex;
    align-items: flex-end;
    gap: 0;
    border-radius: 1rem;
    padding: 0.35rem 0.5rem 0.35rem 0.9rem;
    transition: transform 0.25s ease, background-color 0.25s ease;
  }
  .rank-link:hover {
    transform: translateY(-3px);
    background: color-mix(in srgb, var(--brand) 7%, transparent);
  }
  .rank-num {
    font-weight: 900;
    font-size: clamp(3.4rem, 4vw, 4.6rem);
    line-height: 0.85;
    color: transparent;
    -webkit-text-stroke: 2px var(--brand);
    margin-inline-end: -0.55rem;
    user-select: none;
  }
  @supports not (-webkit-text-stroke: 1px black) {
    .rank-num {
      color: var(--brand);
      opacity: 0.55;
    }
  }
  .rank-poster {
    position: relative;
    width: 92px;
    flex-shrink: 0;
    border-radius: 0.8rem;
    overflow: hidden;
    border: 1px solid var(--border);
    aspect-ratio: 2 / 3;
    background: var(--bg-soft);
    box-shadow: 0 10px 28px -14px rgba(0, 0, 0, 0.55);
    transition: box-shadow 0.25s ease, transform 0.25s ease;
  }
  .rank-link:hover .rank-poster {
    box-shadow: 0 14px 34px -12px var(--brand);
  }
  .rank-poster img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .rank-play {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    background: rgba(0, 0, 0, 0.35);
    opacity: 0;
    transition: opacity 0.25s ease;
  }
  .rank-link:hover .rank-play,
  .rank-link:focus-visible .rank-play {
    opacity: 1;
  }
  .rank-meta {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    max-width: 9rem;
  }
  .rank-title {
    font-size: 0.82rem;
    font-weight: 800;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .rank-sub {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.72rem;
  }
</style>
