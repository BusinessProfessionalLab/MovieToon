---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
---
<Base title="فراموشی گذرواژه" description="بازیابی گذرواژه حساب مووی‌تون" noindex>
  <div class="mx-auto max-w-md px-4 py-10">
    <Breadcrumbs crumbs={[{ label: 'فراموشی گذرواژه' }]} />
    <div class="card p-6">
      <h1 class="font-black text-xl">بازیابی گذرواژه</h1>
      <p class="muted text-sm mt-1">ایمیل حساب خود را وارد کنید تا لینک بازیابی (نمایشی) ارسال شود.</p>
      <form id="fp-form" class="grid gap-3 mt-5" novalidate>
        <div>
          <label for="email" class="text-sm font-bold block mb-1">ایمیل</label>
          <input id="email" class="w-full rounded-xl border px-3 py-2.5 text-sm" style="background: var(--bg); border-color: var(--border)" placeholder="example@mail.com" dir="ltr" />
        </div>
        <p id="form-error" role="alert" class="hidden text-sm font-bold" style="color: var(--brand)"></p>
        <button class="btn-primary text-sm w-full justify-center" type="submit">ارسال لینک بازیابی</button>
      </form>
      <p class="text-sm mt-4"><a href="/login" class="font-bold" style="color: var(--brand)">→ بازگشت به ورود</a></p>
    </div>
  </div>
</Base>
<script is:inline>
  document.getElementById('fp-form')?.addEventListener('submit', (e) => {
    e.preventDefault();
    const v = document.getElementById('email').value.trim();
    const err = document.getElementById('form-error');
    if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(v)) {
      err.textContent = 'نشانی ایمیل معتبر نیست.';
      err.classList.remove('hidden');
      return;
    }
    err.classList.add('hidden');
    window.movietoonToast?.('لینک بازیابی (نمایشی) ارسال شد ✉️');
  });
</script>
