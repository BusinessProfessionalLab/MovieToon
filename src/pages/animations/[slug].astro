---
import Base from '../../layouts/Base.astro';
import TitleDetail from '../../components/TitleDetail.astro';
import { getTitle, getTitleSlugs } from '../../lib/api';

export async function getStaticPaths() {
  return (await getTitleSlugs('animation')).map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const title = await getTitle(slug);
if (!title) return Astro.redirect('/404');
---
<Base title={title.titleFa} description={`تماشای انیمیشن ${title.titleFa} با دوبله فارسی`} ogImage={title.backdrop}>
  <TitleDetail title={title} backLabel="انیمیشن‌ها" backHref="/animations" />
</Base>
