---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import TitleCard from '../../components/TitleCard.astro';
import Pagination from '../../components/Pagination.astro';
import EmptyState from '../../components/EmptyState.astro';
import { titles, genres } from '../../data';
import { filterTitles, paginate } from '../../lib/repository';
import { toFa } from '../../lib/fa';

const params = Astro.url.searchParams;
const page = Number(params.get('page') ?? 1) || 1;
const genre = params.get('genre') ?? '';
const ageGroup = params.get('age') ?? '';
const sort = (params.get('sort') as 'newest' | 'views' | 'rating') || 'newest';

const filtered = filterTitles(titles, { type: 'animation', genre: genre || undefined, ageGroup: ageGroup || undefined, sort });
const { items, totalPages, page: safe } = paginate(filtered, page, 12);
const base = `/animations?genre=${encodeURIComponent(genre)}&age=${encodeURIComponent(ageGroup)}&sort=${sort}`;
---
<Base title="انیمیشن‌ها" description="انیمیشن‌های کودک، نوجوان و خانواده با دوبله فارسی — مووی‌تون">
  <div class="mx-auto max-w-7xl px-4 py-6">
    <Breadcrumbs crumbs={[{ label: 'انیمیشن‌ها' }]} />
    <h1 class="font-black text-2xl mb-1">انیمیشن‌ها</h1>
    <p class="muted text-sm mb-5">{toFa(filtered.length)} عنوان پیدا شد</p>
    <form method="get" action="/animations" class="card p-4 grid gap-3 sm:grid-cols-4 mb-6" aria-label="فیلتر انیمیشن‌ها">
      <label class="text-sm">ژانر
        <select name="genre" class="mt-1 w-full rounded-lg border px-2 py-2 text-sm" style="background: var(--bg); border-color: var(--border)">
          <option value="">همه</option>
          {genres.map((g) => <option value={g.name} selected={genre === g.name}>{g.name}</option>)}
        </select>
      </label>
      <label class="text-sm">رده سنی
        <select name="age" class="mt-1 w-full rounded-lg border px-2 py-2 text-sm" style="background: var(--bg); border-color: var(--border)">
          <option value="">همه</option>
          {['کودک', 'نوجوان', 'خانواده'].map((a) => <option value={a} selected={ageGroup === a}>{a}</option>)}
        </select>
      </label>
      <label class="text-sm">مرتب‌سازی
        <select name="sort" class="mt-1 w-full rounded-lg border px-2 py-2 text-sm" style="background: var(--bg); border-color: var(--border)">
          <option value="newest" selected={sort === 'newest'}>جدیدترین</option>
          <option value="views" selected={sort === 'views'}>پربیننده‌ترین</option>
          <option value="rating" selected={sort === 'rating'}>بالاترین امتیاز</option>
        </select>
      </label>
      <div class="flex items-end"><button class="btn-primary text-sm w-full" type="submit">اعمال فیلتر</button></div>
    </form>
    {items.length === 0 ? (
      <EmptyState title="انیمیشنی پیدا نشد" />
    ) : (
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-3">
        {items.map((t) => <TitleCard title={t} />)}
      </div>
    )}
    <Pagination page={safe} totalPages={totalPages} base={base} />
  </div>
</Base>
