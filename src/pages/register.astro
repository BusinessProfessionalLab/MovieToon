---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
---
<Base title="ساخت حساب" description="ساخت حساب کاربری مووی‌تون" noindex>
  <div class="mx-auto max-w-md px-4 py-10">
    <Breadcrumbs crumbs={[{ label: 'ساخت حساب' }]} />
    <div class="card p-6 md:p-8">
      <p class="text-xs font-bold tracking-widest" style="color:var(--brand)">به جمع ما بپیوند</p>
      <h1 class="font-black text-2xl mt-1">ساخت حساب کاربری</h1>
      <p class="muted text-sm mt-2">حساب کاربری‌ات را بساز و ادامه بده.</p>
      <form id="register-form" class="grid gap-4 mt-6" novalidate>
        <div>
          <label for="name" class="text-sm font-bold block mb-1">نام نمایشی</label>
          <input id="name" name="name" autocomplete="name" required minlength="2" maxlength="80" class="w-full rounded-xl border px-3 py-3 text-sm" style="background:var(--bg);border-color:var(--border)" placeholder="نام و نام خانوادگی" />
        </div>
        <div>
          <label for="email" class="text-sm font-bold block mb-1">ایمیل</label>
          <input id="email" name="email" type="email" autocomplete="email" required class="w-full rounded-xl border px-3 py-3 text-sm" style="background:var(--bg);border-color:var(--border)" placeholder="you@example.com" dir="ltr" />
        </div>
        <div>
          <label for="password" class="text-sm font-bold block mb-1">گذرواژه</label>
          <input id="password" name="password" type="password" autocomplete="new-password" required minlength="12" maxlength="128" class="w-full rounded-xl border px-3 py-3 text-sm" style="background:var(--bg);border-color:var(--border)" placeholder="حداقل ۱۲ نویسه" />
          <span class="muted text-xs mt-1 block">برای امنیت بیشتر، گذرواژه‌ی طولانی و یکتا انتخاب کن.</span>
        </div>
        <div>
          <label for="password2" class="text-sm font-bold block mb-1">تکرار گذرواژه</label>
          <input id="password2" name="password2" type="password" autocomplete="new-password" required minlength="12" maxlength="128" class="w-full rounded-xl border px-3 py-3 text-sm" style="background:var(--bg);border-color:var(--border)" />
        </div>
        <p id="form-error" role="alert" class="hidden text-sm font-bold" style="color:var(--brand)"></p>
        <button class="btn-primary text-sm w-full justify-center" type="submit">ساخت حساب</button>
      </form>
      <p class="text-sm mt-5">قبلاً حساب ساخته‌ای؟ <a href="/login" class="font-bold" style="color:var(--brand)">وارد شو</a></p>
    </div>
  </div>
</Base>
<script is:inline>
  document.getElementById('register-form')?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const form = event.currentTarget;
    const value = (name) => form.elements.namedItem(name).value;
    const button = form.querySelector('button[type="submit"]');
    const error = document.getElementById('form-error');
    const showError = (message) => { error.textContent = message; error.classList.remove('hidden'); };
    error.classList.add('hidden');
    if (value('password') !== value('password2')) return showError('تکرار گذرواژه با گذرواژه یکسان نیست.');
    button.disabled = true;
    try {
      const response = await fetch('/api/auth/register', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name: value('name'), email: value('email'), password: value('password') }),
      });
      const result = await response.json();
      if (!response.ok) throw new Error(result.error || 'ساخت حساب انجام نشد.');
      window.location.assign('/profile');
    } catch (err) {
      showError(err.message || 'ارتباط با سرور برقرار نشد.');
      button.disabled = false;
    }
  });
</script>
