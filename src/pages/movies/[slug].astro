---
import Base from '../../layouts/Base.astro';
import TitleDetail from '../../components/TitleDetail.astro';
import { getTitle, getTitleSlugs } from '../../lib/api';

export async function getStaticPaths() {
  return (await getTitleSlugs('movie')).map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const title = await getTitle(slug);
if (!title) return Astro.redirect('/404');
---
<Base
  title={title.titleFa}
  description={`تماشای ${title.titleFa} (${title.titleEn}) با دوبله و زیرنویس فارسی — ${title.description.slice(0, 120)}`}
  ogImage={title.backdrop}
>
  <TitleDetail title={title} backLabel="فیلم‌ها" backHref="/movies" />
</Base>
