---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const user = Astro.locals.user;
const requestedNext = Astro.url.searchParams.get('next');
const explicitNext =
  requestedNext?.startsWith('/') && !requestedNext.startsWith('//') ? requestedNext : null;
if (user) return Astro.redirect(explicitNext ?? (user.role === 'admin' ? '/admin' : '/profile'));
---
<Base title="ورود" description="ورود امن به حساب کاربری مووی‌تون" noindex>
  <div class="mx-auto max-w-md px-4 py-10">
    <Breadcrumbs crumbs={[{ label: 'ورود' }]} />
    <div class="card p-6 md:p-8">
      <p class="text-xs font-bold tracking-widest" style="color:var(--brand)">خوش برگشتی</p>
      <h1 class="font-black text-2xl mt-1">ورود به مووی‌تون</h1>
      <p class="muted text-sm mt-2">برای ادامه، مشخصات حساب کاربری‌ات را وارد کن.</p>
      <form id="login-form" class="grid gap-4 mt-6" novalidate>
        <div>
          <label for="email" class="text-sm font-bold block mb-1">ایمیل</label>
          <input id="email" name="email" type="email" autocomplete="email" required class="w-full rounded-xl border px-3 py-3 text-sm" style="background:var(--bg);border-color:var(--border)" placeholder="you@example.com" dir="ltr" />
        </div>
        <div>
          <label for="password" class="text-sm font-bold block mb-1">گذرواژه</label>
          <input id="password" name="password" type="password" autocomplete="current-password" required class="w-full rounded-xl border px-3 py-3 text-sm" style="background:var(--bg);border-color:var(--border)" placeholder="گذرواژه حساب" />
        </div>
        <p id="form-error" role="alert" class="hidden text-sm font-bold" style="color:var(--brand)"></p>
        <button class="btn-primary text-sm w-full justify-center" type="submit">ورود امن</button>
      </form>
      <div class="flex justify-between text-sm mt-5">
        <a href="/forgot-password" class="font-bold" style="color:var(--brand)">فراموشی گذرواژه؟</a>
        <a href="/register" class="font-bold" style="color:var(--brand)">ساخت حساب</a>
      </div>
    </div>
  </div>
</Base>
<script is:inline define:vars={{ explicitNext }}>
  document.getElementById('login-form')?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const form = event.currentTarget;
    const value = (name) => form.elements.namedItem(name).value;
    const button = form.querySelector('button[type="submit"]');
    const error = document.getElementById('form-error');
    error.classList.add('hidden');
    button.disabled = true;
    try {
      const response = await fetch(`${window.__MT_API__ || ''}/api/auth/login`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'include',
        body: JSON.stringify({ email: value('email'), password: value('password') }),
      });
      const result = await response.json();
      if (!response.ok) throw new Error(result.error || 'ورود انجام نشد.');
      const role = result?.data?.user?.role ?? result?.data?.role;
      window.location.assign(explicitNext ?? (role === 'admin' ? '/admin' : '/profile'));
    } catch (err) {
      error.textContent = err.message || 'ارتباط با سرور برقرار نشد.';
      error.classList.remove('hidden');
      button.disabled = false;
    }
  });
</script>
