---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
---
<Base title="ورود" description="ورود به حساب کاربری مووی‌تون" noindex>
  <div class="mx-auto max-w-md px-4 py-10">
    <Breadcrumbs crumbs={[{ label: 'ورود' }]} />
    <div class="card p-6">
      <h1 class="font-black text-xl">ورود به مووی‌تون</h1>
      <p class="muted text-sm mt-1">نسخه نمایشی — ورود واقعی انجام نمی‌شود.</p>
      <form id="login-form" class="grid gap-3 mt-5" novalidate>
        <div>
          <label for="email" class="text-sm font-bold block mb-1">ایمیل یا شماره موبایل</label>
          <input id="email" name="email" class="w-full rounded-xl border px-3 py-2.5 text-sm" style="background: var(--bg); border-color: var(--border)" placeholder="example@mail.com" dir="ltr" />
        </div>
        <div>
          <label for="password" class="text-sm font-bold block mb-1">گذرواژه</label>
          <input id="password" name="password" type="password" class="w-full rounded-xl border px-3 py-2.5 text-sm" style="background: var(--bg); border-color: var(--border)" placeholder="••••••••" />
        </div>
        <p id="form-error" role="alert" class="hidden text-sm font-bold" style="color: var(--brand)"></p>
        <button class="btn-primary text-sm w-full justify-center" type="submit">ورود</button>
      </form>
      <div class="flex justify-between text-sm mt-4">
        <a href="/forgot-password" class="font-bold" style="color: var(--brand)">فراموشی گذرواژه؟</a>
        <a href="/register" class="font-bold" style="color: var(--brand)">ثبت‌نام</a>
      </div>
    </div>
  </div>
</Base>
<script is:inline>
  document.getElementById('login-form')?.addEventListener('submit', (e) => {
    e.preventDefault();
    const email = document.getElementById('email').value.trim();
    const pass = document.getElementById('password').value;
    const err = document.getElementById('form-error');
    const show = (m) => { err.textContent = m; err.classList.remove('hidden'); };
    if (!email) return show('لطفا ایمیل یا شماره موبایل را وارد کنید.');
    if (email.includes('@') && !/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)) return show('نشانی ایمیل معتبر نیست.');
    if (pass.length < 6) return show('گذرواژه باید حداقل ۶ حرف باشد.');
    err.classList.add('hidden');
    window.movietoonToast?.('ورود نمایشی با موفقیت انجام شد 🎉');
  });
</script>
