---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import TitleCard from '../../components/TitleCard.astro';
import { getCollectionsWithTitles } from '../../lib/api';
---
<Base title="مجموعه‌ها" description="کالکشن‌های منتخب مووی‌تون: درام، خانوادگی و جنایی">
  <div class="mx-auto max-w-7xl px-4 py-6 space-y-10">
    <Breadcrumbs crumbs={[{ label: 'مجموعه‌ها' }]} />
    <h1 class="font-black text-2xl">مجموعه‌ها</h1>
    {(await getCollectionsWithTitles()).map(({ collection: c, titles: items }) => {
      return (
        <section aria-label={c.name}>
          <div class="relative overflow-hidden rounded-2xl border mb-4" style="border-color: var(--border)">
            <img src={c.cover} alt="" aria-hidden="true" class="w-full h-44 object-cover" />
            <div class="absolute inset-0" style="background: linear-gradient(to top, rgba(0,0,0,.8), transparent)"></div>
            <div class="absolute bottom-3 start-5 text-white">
              <h2 class="font-black text-xl">{c.name}</h2>
              <p class="text-sm opacity-80">{c.description}</p>
            </div>
          </div>
          <div class="grid grid-cols-2 sm:grid-cols-4 md:grid-cols-6 gap-3">
            {items.map((t) => t && <TitleCard title={t} />)}
          </div>
        </section>
      );
    })}
  </div>
</Base>
