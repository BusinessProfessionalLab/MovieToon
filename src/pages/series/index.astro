---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import TitleCard from '../../components/TitleCard.astro';
import Pagination from '../../components/Pagination.astro';
import EmptyState from '../../components/EmptyState.astro';
import { getAllTitles, getGenres, listTitles } from '../../lib/api';
import { toFa } from '../../lib/fa';

const params = Astro.url.searchParams;
const page = Number(params.get('page') ?? 1) || 1;
const genre = params.get('genre') ?? '';
const year = params.get('year') ? Number(params.get('year')) : undefined;
const sort = (params.get('sort') as 'newest' | 'views' | 'rating' | 'year') || 'newest';

const [{ data: items, meta }, allGenres, allTitles] = await Promise.all([
  listTitles({ type: 'series', genre: genre || undefined, year, sort, page, pageSize: 12 }),
  getGenres(),
  getAllTitles(),
]);
const totalPages = meta.totalPages;
const safe = meta.page;
const total = meta.total;
const base = `/series?genre=${encodeURIComponent(genre)}&year=${year ?? ''}&sort=${sort}`;
const years = [...new Set(allTitles.map((t) => t.year))].sort((a, b) => b - a);
const genres = allGenres;
---
<Base title="سریال‌ها" description="آرشیو سریال‌های ایرانی و خارجی با دوبله و زیرنویس فارسی — مووی‌تون">
  <div class="mx-auto max-w-7xl px-4 py-6">
    <Breadcrumbs crumbs={[{ label: 'سریال‌ها' }]} />
    <h1 class="font-black text-2xl mb-1">سریال‌ها</h1>
    <p class="muted text-sm mb-5">{toFa(total)} عنوان پیدا شد</p>
    <form method="get" action="/series" class="card p-4 grid gap-3 sm:grid-cols-4 mb-6" aria-label="فیلتر سریال‌ها">
      <label class="text-sm">ژانر
        <select name="genre" class="mt-1 w-full rounded-lg border px-2 py-2 text-sm" style="background: var(--bg); border-color: var(--border)">
          <option value="">همه</option>
          {genres.map((g) => <option value={g.name} selected={genre === g.name}>{g.name}</option>)}
        </select>
      </label>
      <label class="text-sm">سال
        <select name="year" class="mt-1 w-full rounded-lg border px-2 py-2 text-sm" style="background: var(--bg); border-color: var(--border)">
          <option value="">همه</option>
          {years.map((y: number) => <option value={y} selected={year === y}>{toFa(y)}</option>)}
        </select>
      </label>
      <label class="text-sm">مرتب‌سازی
        <select name="sort" class="mt-1 w-full rounded-lg border px-2 py-2 text-sm" style="background: var(--bg); border-color: var(--border)">
          <option value="newest" selected={sort === 'newest'}>جدیدترین</option>
          <option value="views" selected={sort === 'views'}>پربیننده‌ترین</option>
          <option value="rating" selected={sort === 'rating'}>بالاترین امتیاز</option>
        </select>
      </label>
      <div class="flex items-end"><button class="btn-primary text-sm w-full" type="submit">اعمال فیلتر</button></div>
    </form>
    {items.length === 0 ? (
      <EmptyState title="سریالی پیدا نشد" />
    ) : (
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-3">
        {items.map((t) => <TitleCard title={t} />)}
      </div>
    )}
    <Pagination page={safe} totalPages={totalPages} base={base} />
  </div>
</Base>
