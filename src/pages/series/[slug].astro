---
import Base from '../../layouts/Base.astro';
import TitleDetail from '../../components/TitleDetail.astro';
import { getTitle, getTitleSlugs } from '../../lib/api';

export async function getStaticPaths() {
  return (await getTitleSlugs('series')).map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const title = await getTitle(slug);
if (!title) return Astro.redirect('/404');
---
<Base title={title.titleFa} description={`تماشای سریال ${title.titleFa} با دوبله و زیرنویس فارسی`} ogImage={title.backdrop}>
  <TitleDetail title={title} backLabel="سریال‌ها" backHref="/series" />
</Base>
