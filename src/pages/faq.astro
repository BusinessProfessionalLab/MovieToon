---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const faqs = [
  { q: 'آیا تماشا رایگان است؟', a: 'این نسخه نمایشی است و همه بخش‌ها بدون پرداخت قابل مشاهده‌اند. در نسخه نهایی، طرح‌های اشتراک ماهانه و سالانه ارائه می‌شود.' },
  { q: 'چطور فیلم‌ها را دانلود کنم؟', a: 'در نسخه نمایشی دانلود واقعی وجود ندارد. در نسخه نهایی، کاربران دارای اشتراک می‌توانند از بخش تماشا دانلود آفلاین داشته باشند.' },
  { q: 'زیرنویس و دوبله چطور فعال می‌شود؟', a: 'از صفحه تماشا، منوی زیرنویس را باز کنید و گزینه فارسی یا انگلیسی را انتخاب کنید. بیشتر عناوین دارای دوبله فارسی هستند.' },
  { q: 'چرا ویدیو پخش نمی‌شود؟', a: 'ویدیوهای این نسخه صرفا جایگزین نمایشی هستند. اتصال اینترنت خود را بررسی کنید و مرورگر را به‌روز نگه دارید.' },
  { q: 'چطور علاقه‌مندی‌ها ذخیره می‌شود؟', a: 'علاقه‌مندی‌ها و تماشای بعدی در حافظه محلی مرورگر شما ذخیره می‌شوند و با پاک شدن داده‌های مرورگر از بین می‌روند.' },
  { q: 'چطور محتوای نامناسب را گزارش کنم؟', a: 'از صفحه «گزارش محتوا» فرم گزارش را پر کنید تا تیم ما بررسی کند.' },
];
---
<Base title="سوالات متداول" description="پاسخ پرسش‌های پرتکرار درباره مووی‌تون">
  <div class="mx-auto max-w-3xl px-4 py-8">
    <Breadcrumbs crumbs={[{ label: 'سوالات متداول' }]} />
    <h1 class="font-black text-2xl mb-5">سوالات متداول</h1>
    <div class="grid gap-3">
      {faqs.map((f, i) => (
        <details class="card p-4" open={i === 0}>
          <summary class="font-bold text-sm cursor-pointer">{f.q}</summary>
          <p class="text-sm leading-8 muted mt-2">{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</Base>
