---
import Base from '../layouts/Base.astro';
---
<Base title="صفحه پیدا نشد" description="صفحه مورد نظر پیدا نشد — مووی‌تون" noindex>
  <div class="mx-auto max-w-md px-4 py-16 text-center">
    <p class="font-black text-7xl" style="color: var(--brand)">۴۰۴</p>
    <h1 class="font-black text-xl mt-4">صفحه پیدا نشد!</h1>
    <p class="muted text-sm mt-2 leading-7">به نظر می‌رسد آدرس اشتباه است یا این صفحه حذف شده است.</p>
    <div class="flex justify-center gap-2 mt-6">
      <a href="/" class="btn-primary text-sm">بازگشت به خانه</a>
      <a href="/search" class="btn-ghost text-sm">جستجو</a>
    </div>
  </div>
</Base>
