---
import Base from '../../layouts/Base.astro';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/login?next=%2Fadmin');
if (user.role !== 'admin') return new Response('Forbidden', { status: 403 });
---
<Base title="پنل مدیریت" description="پنل مدیریت مووی‌تون" noindex>
  <main class="mx-auto max-w-7xl px-4 py-10 min-h-[60vh]">
    <h1 class="font-black text-2xl">پنل مدیریت</h1>
  </main>
</Base>
