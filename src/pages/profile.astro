---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { toFa } from '../lib/fa';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/login?next=%2Fprofile');
---
<Base title="حساب کاربری" description="حساب کاربری مووی‌تون" noindex>
  <div class="mx-auto max-w-4xl px-4 py-8 min-h-[65vh]">
    <Breadcrumbs crumbs={[{ label: 'حساب کاربری' }]} />
    <div class="card p-6 md:p-8">
      <div class="flex flex-wrap items-start justify-between gap-5">
        <div>
          <p class="text-xs font-bold tracking-widest" style="color:var(--brand)">حساب من</p>
          <h1 class="font-black text-2xl mt-1">خوش آمدی، {user.name}</h1>
          <p class="muted text-sm mt-2" dir="ltr">{user.email}</p>
        </div>
        <button id="logout-button" type="button" class="btn-ghost text-sm">خروج از حساب</button>
      </div>
      <dl class="grid gap-4 sm:grid-cols-2 mt-8 border-t pt-6" style="border-color:var(--border)">
        <div><dt class="muted text-xs">نقش حساب</dt><dd class="font-bold mt-1">{user.role === 'admin' ? 'مدیر' : 'کاربر'}</dd></div>
        <div><dt class="muted text-xs">عضویت از</dt><dd class="font-bold mt-1">{toFa(new Date(user.created_at * 1000).toLocaleDateString('fa-IR'))}</dd></div>
      </dl>
      {user.role === 'admin' && <a href="/admin" class="btn-primary text-sm mt-6">ورود به پنل مدیریت</a>}
    </div>
  </div>
</Base>
<script is:inline>
  document.getElementById('logout-button')?.addEventListener('click', async () => {
    await fetch('/api/auth/logout', { method: 'POST' });
    window.location.assign('/');
  });
</script>
