---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import TitleCard from '../../components/TitleCard.astro';
import { actorTitles as localActorTitles, actors as localActors } from '../../data';
import { getActor, getActorSlugs } from '../../lib/api';
import { toFa } from '../../lib/fa';

export async function getStaticPaths() {
  return (await getActorSlugs()).map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const found = await getActor(slug);
const local = localActors.find((a) => a.slug === slug);
if (!found && !local) return Astro.redirect('/404');
const actor = found?.actor ?? local!;
const works = found?.titles ?? localActorTitles(actor.name);
---
<Base title={actor.name} description={`بیوگرافی ${actor.name} و فیلم‌های او — ${actor.bio.slice(0, 120)}`} ogImage={actor.photo}>
  <div class="mx-auto max-w-7xl px-4 py-6">
    <Breadcrumbs crumbs={[{ label: 'بازیگران' }, { label: actor.name }]} />
    <section class="card p-5 md:p-8 flex flex-col sm:flex-row gap-6">
      <img src={actor.photo} alt={`تصویر ${actor.name}`} width="200" height="200" class="rounded-2xl object-cover w-40 h-40 mx-auto sm:mx-0" />
      <div>
        <h1 class="font-black text-2xl">{actor.name}</h1>
        <p class="muted text-sm mt-1" dir="ltr" style="text-align: right">{actor.latinName}</p>
        <p class="text-sm mt-2">متولد {toFa(actor.birthYear)} • {actor.birthPlace} • {toFa(works.length)} اثر در مووی‌تون</p>
        <p class="text-sm leading-8 mt-3">{actor.bio}</p>
      </div>
    </section>
    <h2 class="font-black text-lg mt-8 mb-4">فیلم‌شناسی</h2>
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-3">
      {works.map((t) => <TitleCard title={t} />)}
    </div>
  </div>
</Base>
