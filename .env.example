# Required in production: generate with `node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"`
AUTH_JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes-long
AUTH_DB_PATH=./data/movietoon.sqlite

# Temporary values for the first admin only; admin:create removes these lines from .env on success.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_PASSWORD=
