# Copy to .env for local development.
# API_INTERNAL_URL: server side only (SSR + middleware).
# PUBLIC_API_URL: if set, the browser calls the API directly (cross-origin).
#   Leave it unset to keep same-origin /api/* (dev proxy / Vercel rewrite).
API_INTERNAL_URL=http://localhost:3001
# PUBLIC_API_URL=http://localhost:3001
