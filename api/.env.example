# Copy to .env and fill in. Never commit real secrets.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=movietoon
DB_PASSWORD=change-me-to-a-strong-password
DB_NAME=movietoon
# Managed providers (Neon) need TLS.
DB_SSL=false
PORT=3001
# Comma-separated list of allowed browser origins.
CORS_ORIGIN=http://localhost:4321,https://www.movietoon.ir,https://movietoon.ir
JWT_ACCESS_SECRET=change-me-to-a-random-string-at-least-32-chars-long-0000
JWT_REFRESH_SECRET=change-me-to-a-different-random-string-at-least-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
COOKIE_SECURE=false
# Set to the registrable domain (e.g. movietoon.ir) when the frontend and API
# live on different subdomains: the cookie is then sent to both, so SSR on the
# frontend can read the session. Leave empty for a single-host setup.
COOKIE_DOMAIN=
