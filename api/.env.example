# Copy to .env and fill in. Never commit real secrets.
PORT=3001
DATABASE_PATH=./dev.sqlite
CORS_ORIGIN=http://localhost:4321
JWT_ACCESS_SECRET=change-me-to-a-random-string-at-least-32-chars-long-0000
JWT_REFRESH_SECRET=change-me-to-a-different-random-string-at-least-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
COOKIE_SECURE=false
COOKIE_DOMAIN=
