{
  "name": "movietoon",
  "type": "module",
  "version": "1.0.0",
  "description": "مووی‌تون — وب‌سایت فارسی تماشای فیلم، سریال و انیمیشن (فرانت‌اند)",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env ./node_modules/astro/astro.js dev",
    "build": "astro build",
    "preview": "node --env-file-if-exists=.env ./node_modules/astro/astro.js preview",
    "start": "node --env-file-if-exists=.env ./scripts/start.mjs",
    "astro": "astro",
    "lint": "eslint src --ext .ts,.tsx,.astro",
    "format": "prettier --write \"src/**/*.{ts,tsx,astro,css}\""
  },
  "dependencies": {
    "@astrojs/node": "^9.5.3",
    "@astrojs/react": "^4.2.0",
    "@astrojs/sitemap": "^3.2.1",
    "@astrojs/tailwind": "^6.0.2",
    "@astrojs/vercel": "^8.2.11",
    "astro": "^5.13.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "prettier-plugin-astro": "^0.14.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  }
}
