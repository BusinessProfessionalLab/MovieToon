# SSR (middleware) talks to the API directly.
API_INTERNAL_URL=https://api.movietoon.ir
# PUBLIC_API_URL is intentionally unset: the browser uses same-origin /api/*
# (dev proxy / Vercel rewrite in vercel.json) so mt_access/mt_refresh stay
# first-party cookies and SSR (middleware) sees the session.
# Do NOT set PUBLIC_API_URL to https://api.movietoon.ir — cross-origin calls
# drop the session and /profile bounces back to /login.
